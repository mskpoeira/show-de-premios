# =============================================================================
# SHOW DE PRÊMIOS — VARIÁVEIS DE AMBIENTE (MODELO .env.example)
# Domínio Oficial: https://showdepremios.mskpoeira.com.br
# NUNCA insira senhas, chaves privadas ou dados de produção neste arquivo.
# =============================================================================

# Configuração da Aplicação
APP_NAME="Show de Prêmios"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://showdepremios.mskpoeira.com.br
APP_BASE_URL=

# Driver de Banco de Dados: sqlite, pgsql ou mysql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# Sessão e Segurança
SESSION_SECRET=
SESSION_LIFETIME=28800

# Configurações Oficiais do PIX (EMVCo / BCB)
PIX_KEY=
PIX_KEY_TYPE=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=
PIX_DESCRIPTION=
PIX_BANNER_TITLE=
PIX_SHOW_ON_TELAO=true

# Logs e Armazenamento
LOG_CHANNEL=file
LOG_LEVEL=info
STORAGE_PATH=storage
