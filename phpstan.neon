parameters:
    level: 7
    paths:
        - app
        - database
        - index.php
    stubFiles:
        - phpstan-pdo.stub
    excludePaths:
        analyse:
            - app/Views
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Dívida estritamente documental: coleções dinâmicas de resultados SQL/HTTP.
        # O nível 7 continua bloqueando unions incorretas, recursos false, código morto
        # e chamadas inválidas em controllers, core, services e migrations.
        - '#no value type specified in iterable type array#'
